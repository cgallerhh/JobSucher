# Copy this file to .env for local testing (never commit .env!)
# In GitHub Actions these are set as Repository Secrets.

# Backwards-compatible Gmail sender configuration.
GMAIL_USER=your.address@gmail.com

# Gmail App Password (NOT your normal password)
# Create at: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Recommended: use a separate sender mailbox so Gmail/Apple Mail does not show
# one self-addressed message under both SENT and INBOX. SMTP_* overrides GMAIL_*.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=jobsucher.bot@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM_EMAIL=jobsucher.bot@gmail.com
# SMTP_FROM_NAME=Job Search Bot

# Where the daily digest should be delivered.
RECIPIENT_EMAIL=christian.galler@gmail.com

# OpenAI API key for AI-powered job scoring (optional but recommended)
# Without this key the system falls back to keyword-based scoring.
OPENAI_API_KEY=sk-...
